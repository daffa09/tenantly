# Copy to .env and fill in. The app refuses to boot without DATABASE_URL and
# JWT_SECRET — there is no built-in fallback secret on purpose.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenantly?schema=public"

# Generate one per environment: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-random-48-byte-secret"
JWT_EXPIRES_IN="7d"

PORT=3001

# Comma-separated list of browser origins allowed to call this API with cookies.
CORS_ORIGINS="http://localhost:3000"

REDIS_HOST="localhost"
REDIS_PORT=6379
