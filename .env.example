# ==========================================
# SECRETS & CONFIG: TENANTLY (production)
# ==========================================
# Copy to .env on the server, fill in, never commit it.
#   cp .env.example .env && nano .env
#
# Postgres is the EXISTING external pgvector container (`postgres` on the
# `postgres_default` network) — this stack does not start its own, and there is
# no migrator service. Create the database and apply the schema once, by hand:
#
#   docker exec -i postgres psql -U postgres -c "CREATE DATABASE tenantly;"
#   docker exec -i postgres psql -U postgres -d tenantly < schema.sql
#
# Then, optionally, the demo tenants (DESTRUCTIVE — truncates every table):
#   docker exec -i postgres psql -U postgres -d tenantly < seed.sql

# --- IMAGE REGISTRY ---
# Must match the DOCKERHUB_USERNAME secret in GitHub Actions, otherwise
# `docker compose pull` on the server looks for images that were never pushed.
DOCKERHUB_USERNAME=daffa09

# --- HOST PORTS (bound to 127.0.0.1, fronted by the host's nginx) ---
WEB_PORT=3010
API_PORT=3011

# --- DATABASE ---
# Host is the container name of the running pgvector instance.
DATABASE_URL=postgresql://postgres:passwordSangatRahasia123@postgres:5432/tenantly?schema=public

# --- API SECRETS ---
# Generate a fresh one per environment: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-48-byte-secret
JWT_EXPIRES_IN=7d

# --- PUBLIC URLS ---
# CORS_ORIGINS is the browser origin of the frontend (comma-separated for more
# than one). The session cookie is httpOnly + credentialed, so '*' is invalid
# here — it must be an exact origin match or login silently fails.
CORS_ORIGINS=https://tenantly.daffathan-labs.my.id
# Baked into the JS bundle at image build time, not read at runtime.
NEXT_PUBLIC_API_URL=https://api.tenantly.daffathan-labs.my.id
