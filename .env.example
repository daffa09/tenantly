# ==========================================
# SECRETS & CONFIG: TENANTLY (production)
# ==========================================

DOCKERHUB_USERNAME=daffa09

# --- HOST PORT (the gateway is the only published port; Caddy proxies to it) ---
WEB_PORT=3010

# --- DATABASE ---
# Host is the container name of the running pgvector instance.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tenantly?schema=public

# --- API SECRETS ---
# Generate a fresh one per environment: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-48-byte-secret
JWT_EXPIRES_IN=7d

# --- PUBLIC URLS ---
# UI and API share one origin behind the gateway, so both are the same value and
# CORS never fires. Keep CORS_ORIGINS exact anyway — the session cookie is
# httpOnly + credentialed, so '*' would break login the day a second origin appears.
CORS_ORIGINS=https://tenantly.daffathan-labs.my.id
# Baked into the JS bundle at image build time, not read at runtime — changing it
# means rebuilding the frontend image, not just restarting it.
NEXT_PUBLIC_API_URL=https://tenantly.daffathan-labs.my.id
